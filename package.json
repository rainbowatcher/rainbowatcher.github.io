{
    "name": "rainbowatcher.github.io",
    "type": "module",
    "version": "0.0.4",
    "packageManager": "pnpm@12.18.0",
    "author": "rainbowatcher <rainbow-w@qq.com>",
    "license": "MIT",
    "repository": "https://github.com/rainbowatcher/rainbowatcher.github.io.git",
    "engines": {
        "node": ">=20",
        "pnpm": ">=9"
    },
    "scripts": {
        "analyze": "nuxi analyze",
        "clean": "nuxi cleanup && pnpm --stream -r clean",
        "check": "pnpm exec lychee -c lychee.toml -f markdown content",
        "build": "pnpm generate",
        "generate": "nuxi generate",
        "prepare": "nuxi prepare && simple-git-hooks",
        "preview": "nuxi preview",
        "docs:dev": "pnpm --filter docs docs:dev",
        "docs:build": "pnpm --filter docs docs:build",
        "dev": "nuxi dev",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "upgrade": "nuxi upgrade"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^21.2.4",
        "@docsearch/css": "^5.2.0",
        "@docsearch/js": "^5.2.0",
        "@golar/vue": "^0.1.11",
        "@iconify-json/line-md": "^1.2.16",
        "@iconify-json/ph": "^1.2.2",
        "@nuxt/fonts": "^1.2.0",
        "@nuxt/image": "^2.2.1",
        "@nuxtjs/color-mode": "^4.1.0",
        "@nuxtjs/mdc": "0.13.5",
        "@nuxtjs/seo": "2.1.1",
        "@unocss/nuxt": "^66.12.0",
        "@unocss/postcss": "^66.12.0",
        "@vueuse/core": "^15.0.0",
        "@vueuse/motion": "^3.0.3",
        "@vueuse/nuxt": "^15.0.0",
        "commitlint": "^21.2.4",
        "golar": "^0.1.11",
        "katex": "^0.19.1",
        "mermaid": "^12.3.0",
        "nuxi": "^4.0.3",
        "nuxt": "^4.6.4",
        "oxfmt": "^0.77.0",
        "oxlint": "^1.92.0",
        "rehype-external-links": "^3.0.0",
        "rehype-katex": "^7.0.1",
        "reka-ui": "^2.11.0",
        "remark-emoji": "^5.0.2",
        "remark-flexible-containers": "^1.5.8",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "shiki": "^4.6.0",
        "simple-git-hooks": "^2.14.0",
        "slugify": "^1.6.9",
        "tailwind-merge": "^3.7.0",
        "typescript": "^7.0.2"
    },
    "simple-git-hooks": {
        "commit-msg": "pnpm exec commitlint --edit $1"
    }
}
